generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── CONFIGURACIÓN BASE ────────────────────────────────────────────────────

model Empresa {
  id       Int     @id @default(autoincrement())
  nombre   String
  rif      String  @unique
  activa   Boolean @default(true)

  cotizaciones Cotizacion[]
  facturas     Factura[]
}

model Vendedor {
  id                  Int       @id @default(autoincrement())
  nombre              String
  comisionPct         Decimal   @db.Decimal(5, 2) @default(0)
  comisionReferidoPct Decimal   @db.Decimal(5, 2) @default(0)
  gananciaMuchachosPct Decimal  @db.Decimal(5, 2) @default(0) // % pago a "los muchachos" (flete) sobre la venta — gasto extra independiente
  referidoPorId       Int?
  referidoPor         Vendedor? @relation("Referidos", fields: [referidoPorId], references: [id])
  referidos           Vendedor[] @relation("Referidos")
  activo              Boolean   @default(true)

  clientes     Cliente[]
  cotizaciones Cotizacion[]
  usuario      Usuario?
}

// ─── CATÁLOGO ──────────────────────────────────────────────────────────────

model CategoriaCosto {
  id            Int     @id @default(autoincrement())
  nombre        String  @unique
  factorCostoKg Decimal @db.Decimal(8, 4)
  gananciaKg    Decimal @db.Decimal(8, 4)
  descripcion   String?

  productos Producto[]
}

model Producto {
  id             Int            @id @default(autoincrement())
  codigo         String?        @unique
  nombre         String
  medida         String
  descripcion    String?
  origen         OrigenProducto @default(INTERNO)
  categoriaId    Int
  categoria      CategoriaCosto @relation(fields: [categoriaId], references: [id])
  pesoUnitarioKg Decimal?       @db.Decimal(8, 4)
  costoCompra    Decimal?       @db.Decimal(12, 4)  // precio publicado de compra (proveedor) — usado para Conexiones
  imagenUrl      String?
  activo         Boolean        @default(true)
  creadoEn       DateTime       @default(now())

  preciosDetalle   ListaPrecioDetalle[]
  cotizacionLineas CotizacionLinea[]
  despachoLineas   DespachoLinea[]
  facturaLineas    FacturaLinea[]
  comprasExternasLineas CompraExternaLinea[]
}

enum OrigenProducto {
  INTERNO
  EXTERNO
}

// ─── LISTAS DE PRECIOS ─────────────────────────────────────────────────────

model ListaPrecio {
  id            Int       @id @default(autoincrement())
  nombre        String
  clienteId     Int?
  cliente       Cliente?  @relation("ListasDelCliente", fields: [clienteId], references: [id])
  vigenciaDesde DateTime  @default(now())
  vigenciaHasta DateTime?
  activa        Boolean   @default(true)
  creadoEn      DateTime  @default(now())

  detalle           ListaPrecioDetalle[]
  clientesAsignados ClienteListaPrecios[]
}

// Tabla de unión: qué listas de precios usa cada cliente
model ClienteListaPrecios {
  id            Int         @id @default(autoincrement())
  clienteId     Int
  cliente       Cliente     @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  listaPrecioId Int
  listaPrecio   ListaPrecio @relation(fields: [listaPrecioId], references: [id])

  @@unique([clienteId, listaPrecioId])
}

model ListaPrecioDetalle {
  id            Int         @id @default(autoincrement())
  listaPrecioId Int
  listaPrecio   ListaPrecio @relation(fields: [listaPrecioId], references: [id])
  productoId    Int
  producto      Producto    @relation(fields: [productoId], references: [id])
  precioUnitario Decimal    @db.Decimal(10, 4)
  descuentoPct  Decimal     @db.Decimal(5, 2) @default(0)

  @@unique([listaPrecioId, productoId])
}

// ─── CLIENTES ──────────────────────────────────────────────────────────────

model Cliente {
  id             Int          @id @default(autoincrement())
  nombre         String
  rif            String?
  rifVerificado  Boolean      @default(false) // marcado a mano tras verificar en el portal del SENIAT
  direccion      String?
  telefono       String?
  email          String?
  vendedorId     Int?
  vendedor       Vendedor?    @relation(fields: [vendedorId], references: [id])
  empresaFactura        String       @default("ECOPLAST F.P.")
  fletePct              Decimal      @db.Decimal(5, 2) @default(0)
  fleteTuberiaPct       Decimal      @db.Decimal(5, 2) @default(0)
  fleteConexionesPct    Decimal      @db.Decimal(5, 2) @default(0)
  comisionTuberiaPct    Decimal      @db.Decimal(5, 2) @default(0)
  comisionConexionesPct Decimal      @db.Decimal(5, 2) @default(0)
  diasCredito           Int          @default(0)
  condicionPago  String?
  observaciones  String?
  activo         Boolean      @default(true)
  creadoEn       DateTime     @default(now())
  // Reglas de distribución de ganancias
  socioEquivalente  String?  // null | "sbug" | "yolanda" | "sandra" | "comisiones"
  vendedorEsMaster  Boolean  @default(false) // true = su comisión está en Ganancias_2

  listasPrecios   ListaPrecio[]         @relation("ListasDelCliente")
  listasAsignadas ClienteListaPrecios[]
  cotizaciones    Cotizacion[]
  facturas      Factura[]
  pagos         Pago[]
}

// ─── COTIZACIONES ──────────────────────────────────────────────────────────

model Cotizacion {
  id               Int              @id @default(autoincrement())
  numero           String           @unique
  clienteId        Int
  cliente          Cliente          @relation(fields: [clienteId], references: [id])
  vendedorId       Int?
  vendedor         Vendedor?        @relation(fields: [vendedorId], references: [id])
  empresaId        Int?
  empresa          Empresa?         @relation(fields: [empresaId], references: [id])
  estado           EstadoCotizacion @default(BORRADOR)
  validezDias      Int              @default(30)
  fechaVencimiento DateTime?
  totalBruto       Decimal          @db.Decimal(12, 2) @default(0)
  descuentoTotal   Decimal          @db.Decimal(12, 2) @default(0)
  totalNeto        Decimal          @db.Decimal(12, 2) @default(0)
  notas            String?
  creadoEn         DateTime         @default(now())
  actualizadoEn    DateTime         @updatedAt

  lineas         CotizacionLinea[]
  despachoLineas DespachoLinea[]
  seguimientos   SeguimientoCotizacion[]
}

enum EstadoCotizacion {
  BORRADOR
  ENVIADA
  APROBADA
  EN_DESPACHO
  COMPLETADA
  RECHAZADA
  VENCIDA
}

model CotizacionLinea {
  id                     Int        @id @default(autoincrement())
  cotizacionId           Int
  cotizacion             Cotizacion @relation(fields: [cotizacionId], references: [id], onDelete: Cascade)
  productoId             Int
  producto               Producto   @relation(fields: [productoId], references: [id])
  cantidad               Decimal    @db.Decimal(10, 2)
  notaCantidad           String?
  precioUnitarioAplicado Decimal    @db.Decimal(10, 4)
  descuentoPct           Decimal    @db.Decimal(5, 2) @default(0)
  precioFinal            Decimal    @db.Decimal(10, 4)
  totalLinea             Decimal    @db.Decimal(12, 2)
  listaPrecioOrigenId    Int?
  pesoTotalKg            Decimal?   @db.Decimal(10, 4)
  orden                  Int        @default(0)
}

// ─── DESPACHOS ─────────────────────────────────────────────────────────────

model OrdenDespacho {
  id          Int            @id @default(autoincrement())
  numero      String         @unique
  fechaSalida DateTime       @default(now())
  chofer      String?
  vehiculo    String?
  estado      EstadoDespacho @default(PENDIENTE)
  notas       String?
  creadoEn    DateTime       @default(now())

  lineas   DespachoLinea[]
  facturas Factura[]
  balance  BalancePago?
}

enum EstadoDespacho {
  PENDIENTE
  EN_RUTA
  ENTREGADO
  PARCIAL
}

model DespachoLinea {
  id                   Int           @id @default(autoincrement())
  ordenDespachoId      Int
  ordenDespacho        OrdenDespacho @relation(fields: [ordenDespachoId], references: [id])
  cotizacionId         Int?
  cotizacion           Cotizacion?   @relation(fields: [cotizacionId], references: [id])
  productoId           Int
  producto             Producto      @relation(fields: [productoId], references: [id])
  cantidadPedida       Decimal       @db.Decimal(10, 2)
  cantidadDespachada   Decimal       @db.Decimal(10, 2) @default(0)
  cantidadFaltante     Decimal       @db.Decimal(10, 2) @default(0)
  estado               EstadoLinea   @default(PENDIENTE)
  esServicioExterno    Boolean       @default(false)
  costoServicioExterno Decimal?      @db.Decimal(12, 2)
  // Tubo Gris PVC comprado a proveedor (costo y proveedor por línea)
  proveedorGris        String?       // "casa_del_tubo" | "alirio"
  costoGrisUnit        Decimal?      @db.Decimal(12, 4)
}

enum EstadoLinea {
  PENDIENTE
  DESPACHADO
  FALTO
  PARCIAL
}

// ─── FACTURAS ──────────────────────────────────────────────────────────────

model Factura {
  id               Int           @id @default(autoincrement())
  numero           String        @unique
  clienteId        Int
  cliente          Cliente       @relation(fields: [clienteId], references: [id])
  ordenDespachoId  Int?
  ordenDespacho    OrdenDespacho? @relation(fields: [ordenDespachoId], references: [id])
  empresaId        Int?
  empresa          Empresa?      @relation(fields: [empresaId], references: [id])
  estado           EstadoFactura @default(EMITIDA)
  fechaEmision     DateTime      @default(now())
  fechaVencimiento DateTime?
  totalBruto       Decimal       @db.Decimal(12, 2) @default(0)
  descuentoTotal   Decimal       @db.Decimal(12, 2) @default(0)
  totalNeto        Decimal       @db.Decimal(12, 2) @default(0)
  totalPagado      Decimal       @db.Decimal(12, 2) @default(0)
  saldoPendiente   Decimal       @db.Decimal(12, 2) @default(0)
  notas            String?
  creadoEn         DateTime      @default(now())
  actualizadoEn    DateTime      @updatedAt

  lineas    FacturaLinea[]
  pagos     PagoAsignacion[]
  gastos    DespachoGasto[]
  ganancias DistribucionGanancia[]
  comprasExternasAsignaciones CompraExternaAsignacion[]
}

enum EstadoFactura {
  EMITIDA
  PENDIENTE_COBRO
  COBRADA_PARCIAL
  COBRADA
  VENCIDA
  ANULADA
}

model FacturaLinea {
  id             Int            @id @default(autoincrement())
  facturaId      Int
  factura        Factura        @relation(fields: [facturaId], references: [id], onDelete: Cascade)
  productoId     Int
  producto       Producto       @relation(fields: [productoId], references: [id])
  cantidad       Decimal        @db.Decimal(10, 2)
  precioUnitario Decimal        @db.Decimal(10, 4)
  descuentoPct   Decimal        @db.Decimal(5, 2) @default(0)
  totalLinea     Decimal        @db.Decimal(12, 2)
  motivoAjuste   String?
  origen         OrigenProducto @default(INTERNO)
  pesoTotalKg    Decimal?       @db.Decimal(10, 4)
  orden          Int            @default(0)
}

// ─── PAGOS Y TESORERÍA ─────────────────────────────────────────────────────

model Pago {
  id                 Int        @id @default(autoincrement())
  clienteId          Int?
  cliente            Cliente?   @relation(fields: [clienteId], references: [id])
  cuentaId           Int?
  cuenta             Cuenta?    @relation(fields: [cuentaId], references: [id])
  monto              Decimal    @db.Decimal(12, 2)
  moneda             Moneda     @default(USD)
  montousd           Decimal?   @db.Decimal(12, 2)
  tasaCambioBs       Decimal?   @db.Decimal(12, 4)
  tasaCambioCop      Decimal?   @db.Decimal(12, 4)
  fecha              DateTime   @default(now())
  estado             EstadoPago @default(LIBRE)
  origenFondos       String?
  destinoUso         String?
  observaciones      String?
  fechaProximoAbono  DateTime?
  creadoEn           DateTime   @default(now())

  asignaciones PagoAsignacion[]
}

enum Moneda {
  USD
  USDT
  BS
  COP
}

enum EstadoPago {
  LIBRE
  ASIGNADO
  PARCIAL
}

model PagoAsignacion {
  id              Int      @id @default(autoincrement())
  pagoId          Int
  pago            Pago     @relation(fields: [pagoId], references: [id])
  facturaId       Int
  factura         Factura  @relation(fields: [facturaId], references: [id])
  montoAsignado   Decimal  @db.Decimal(12, 2)
  fechaAsignacion DateTime @default(now())
  notas           String?
}

model Cuenta {
  id               Int      @id @default(autoincrement())
  nombre           String
  moneda           Moneda
  tipoCuenta       String?  // Ahorro, Corriente, Billetera Digital, Efectivo
  numeroCuenta     String?
  cedula           String?
  propietario      String
  comisionPct      Decimal  @db.Decimal(5, 2) @default(0)
  saldoActual      Decimal  @db.Decimal(12, 2) @default(0)
  activa           Boolean  @default(true)
  ultimoMovimiento DateTime?

  pagos       Pago[]
  movimientos MovimientoTesoreria[]
  comprasExternasPagos CompraExternaPago[]
}

model MovimientoTesoreria {
  id           Int            @id @default(autoincrement())
  cuentaId     Int
  cuenta       Cuenta         @relation(fields: [cuentaId], references: [id])
  tipo         TipoMovimiento
  monto        Decimal        @db.Decimal(12, 2)
  moneda       Moneda
  tasaAplicada Decimal?       @db.Decimal(12, 4)
  facturaId    Int?
  fecha        DateTime       @default(now())
  descripcion  String?
  alertaUsdt   Boolean        @default(false)
}

enum TipoMovimiento {
  ENTRADA
  SALIDA
  TRANSFERENCIA
  COMISION
}

// ─── COSTOS Y GANANCIAS ────────────────────────────────────────────────────

model DespachoGasto {
  id              Int     @id @default(autoincrement())
  facturaId       Int
  factura         Factura @relation(fields: [facturaId], references: [id])
  renglon         String
  monto           Decimal @db.Decimal(12, 2)
  formulaAplicada String?
  esVariable      Boolean @default(false)
  notas           String?
}

model DistribucionGanancia {
  id             Int     @id @default(autoincrement())
  facturaId      Int
  factura        Factura @relation(fields: [facturaId], references: [id])
  beneficiario   String
  tipo           String
  porcentaje     Decimal @db.Decimal(5, 2)
  montoCalculado Decimal @db.Decimal(12, 2)
  montoAbonado   Decimal @db.Decimal(12, 2) @default(0)
  saldoPendiente Decimal @db.Decimal(12, 2)
  notas          String?
}

// ─── BALANCE DE PAGOS ──────────────────────────────────────────────────────

model BalancePago {
  id              Int               @id @default(autoincrement())
  ordenDespachoId Int               @unique
  ordenDespacho   OrdenDespacho     @relation(fields: [ordenDespachoId], references: [id], onDelete: Cascade)
  nombre          String?
  gananciaVendedor Decimal?         @db.Decimal(12, 2) @default(0) // comisión del vendedor — sección superior, NO suma en el balance
  // Snapshot del cálculo — preserva los valores aunque cambien tasas en el código
  calculadoEn     DateTime?
  calculosJson    String?           @db.Text   // JSON con el resultado completo de ganancias
  tasasJson       String?           @db.Text   // JSON con las tasas usadas al calcular
  creadoEn        DateTime          @default(now())
  actualizadoEn   DateTime          @updatedAt
  items           BalancePagoItem[]
}

model BalancePagoItem {
  id            Int               @id @default(autoincrement())
  balancePagoId Int
  balancePago   BalancePago       @relation(fields: [balancePagoId], references: [id], onDelete: Cascade)
  nombre        String
  montoTotal    Decimal           @db.Decimal(12, 2)
  esEditable    Boolean           @default(false)
  orden         Int               @default(0)
  notas         String?
  cuotas        BalancePagoCuota[]
}

model BalancePagoCuota {
  id                Int             @id @default(autoincrement())
  balancePagoItemId Int
  balancePagoItem   BalancePagoItem @relation(fields: [balancePagoItemId], references: [id], onDelete: Cascade)
  fecha             DateTime        @db.Date
  monto             Decimal         @db.Decimal(12, 2)
  notas             String?
  creadoEn          DateTime        @default(now())
}

model Secuencia {
  id      Int    @id @default(autoincrement())
  prefijo String @unique
  ultimo  Int    @default(0)
}

// ─── USUARIOS Y AUTENTICACIÓN ──────────────────────────────────────────────

enum RolUsuario {
  MASTER
  ADMIN
  VENDEDOR
}

model Usuario {
  id           Int        @id @default(autoincrement())
  nombre       String
  email        String     @unique
  passwordHash String
  rol          RolUsuario @default(VENDEDOR)
  vendedorId   Int?       @unique
  vendedor     Vendedor?  @relation(fields: [vendedorId], references: [id])
  activo       Boolean    @default(true)
  creadoEn     DateTime   @default(now())
  ultimoAcceso DateTime?

  seguimientos SeguimientoCotizacion[]
}

// ─── TASA DE CAMBIO ────────────────────────────────────────────────────────

model TasaCambio {
  id       Int      @id @default(autoincrement())
  fecha    DateTime @default(now())
  bsUSDT   Decimal  @db.Decimal(12, 4)
  copUSDT  Decimal? @db.Decimal(12, 4)
  notas    String?
  creadoEn DateTime @default(now())
}

// ─── SEGUIMIENTO COTIZACIONES ──────────────────────────────────────────────

model SeguimientoCotizacion {
  id                   Int                  @id @default(autoincrement())
  cotizacionId         Int
  cotizacion           Cotizacion           @relation(fields: [cotizacionId], references: [id], onDelete: Cascade)
  tipo                 TipoSeguimiento      @default(NOTA)
  nota                 String
  fechaProxSeguimiento DateTime?
  creadoPorId          Int?
  creadoPor            Usuario?             @relation(fields: [creadoPorId], references: [id])
  creadoEn             DateTime             @default(now())
}

enum TipoSeguimiento {
  NOTA
  ENVIADA
  SEGUIMIENTO
  RECORDATORIO
  MOTIVO_RECHAZO
}

// ─── CONFIGURACIÓN DE GANANCIAS (tablas editables + overrides por despacho) ──

model ConfigGanancias {
  id          Int       @id @default(autoincrement())
  despachoId  Int?      // null = global; número = override solo para ese despacho
  campo       String    // e.g. "costo_manguera34", "gan_gris", "g2_sandra", etc.
  valor       Decimal   @db.Decimal(14, 6)
  notas       String?
  creadoEn    DateTime  @default(now())
  actualizadoEn DateTime @updatedAt

  @@unique([despachoId, campo])
}

// ─── CONFIGURACIÓN SISTEMA (singleton — PIN de tablas, etc.) ──────────────────

model ConfiguracionSistema {
  id           Int     @id @default(1) // siempre 1, singleton
  pinTablaHash String? // bcrypt hash del PIN de Tablas de Distribución
}

// ─── FACTURACIÓN EXTERNA (compras a proveedores) ────────────────────────────
// Registra compras hechas a terceros (con foto de la factura), reparte las
// cantidades compradas entre las facturas de los clientes y lleva los pagos
// que hacemos al proveedor.

model CompraExterna {
  id            Int      @id @default(autoincrement())
  proveedor     String
  numero        String?
  fecha         DateTime @default(now())
  imagenUrl     String?
  totalCosto    Decimal  @db.Decimal(12, 2) @default(0) // suma de líneas (costo)
  notas         String?
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  lineas CompraExternaLinea[]
  pagos  CompraExternaPago[]
}

model CompraExternaLinea {
  id              Int           @id @default(autoincrement())
  compraExternaId Int
  compraExterna   CompraExterna @relation(fields: [compraExternaId], references: [id], onDelete: Cascade)
  productoId      Int
  producto        Producto      @relation(fields: [productoId], references: [id])
  cantidad        Decimal       @db.Decimal(12, 2) // cantidad comprada
  costoUnitario   Decimal       @db.Decimal(12, 4) @default(0)
  notas           String?

  asignaciones CompraExternaAsignacion[]
}

// Reparte una cantidad de una línea a la factura de un cliente
model CompraExternaAsignacion {
  id        Int                @id @default(autoincrement())
  lineaId   Int
  linea     CompraExternaLinea @relation(fields: [lineaId], references: [id], onDelete: Cascade)
  facturaId Int
  factura   Factura            @relation(fields: [facturaId], references: [id])
  cantidad  Decimal            @db.Decimal(12, 2)
  notas     String?
  creadoEn  DateTime           @default(now())
}

// ─── PLANIFICADOR DE CARGA (consolidación de pedidos para un despacho) ───────
// Matriz productos × clientes para dimensionar la carga de un camión antes de
// comprometer cotizaciones. Se guarda como JSON para iterar libremente.
model PlanCarga {
  id             Int       @id @default(autoincrement())
  nombre         String
  fecha          DateTime? // fecha estimada del despacho
  notas          String?
  clientesJson   String    @default("[]") @db.Text // [clienteId, ...] (orden de columnas)
  productosJson  String    @default("[]") @db.Text // [{ id, costo }, ...] (orden de filas)
  cantidadesJson String    @default("{}") @db.Text // { "clienteId_productoId": cantidad }
  estado         String    @default("BORRADOR")    // BORRADOR | GENERADO | DESPACHADO
  cotizacionesIds String   @default("[]") @db.Text // IDs de cotizaciones generadas
  despachoId     Int?                              // despacho consolidado (si ya se armó)
  creadoEn       DateTime  @default(now())
  actualizadoEn  DateTime  @updatedAt
}

// Pago que NOSOTROS hacemos al proveedor (egreso), indicando de qué cuenta salió
model CompraExternaPago {
  id              Int           @id @default(autoincrement())
  compraExternaId Int
  compraExterna   CompraExterna @relation(fields: [compraExternaId], references: [id], onDelete: Cascade)
  cuentaId        Int?
  cuenta          Cuenta?       @relation(fields: [cuentaId], references: [id])
  monto           Decimal       @db.Decimal(12, 2)
  moneda          Moneda        @default(USD)
  fecha           DateTime      @default(now())
  origenFondos    String? // texto libre cuando no hay cuenta seleccionada
  notas           String?
  creadoEn        DateTime      @default(now())
}
